<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>

    <group name="General">
        <entry name="enabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="fontFamily" type="String">
            <default>Noto Sans</default>
        </entry>
        <entry name="fontSize" type="Int">
            <default>24</default>
        </entry>
        <entry name="fontBold" type="Bool">
            <default>true</default>
        </entry>
        <entry name="fontItalic" type="Bool">
            <default>false</default>
        </entry>
        <entry name="useAlbumColor" type="Bool">
            <default>true</default>
        </entry>
        <entry name="customFontColor" type="Color">
            <default>#FFFFFF</default>
        </entry>
        <entry name="timingOffsetMs" type="Int">
            <!-- Kept at the legacy default for the one-time sign migration. -->
            <default>-150</default>
        </entry>
        <entry name="timingOffsetSemanticsVersion" type="Int">
            <default>0</default>
        </entry>
        <entry name="enableWobble" type="Bool">
            <default>true</default>
        </entry>
        <entry name="enableShadow" type="Bool">
            <default>true</default>
        </entry>
        <entry name="enableRomanization" type="Bool">
            <default>true</default>
        </entry>
        <entry name="romanizationOpacity" type="Double">
            <default>0.72</default>
        </entry>
        <entry name="romanizationPrimary" type="Bool">
            <default>false</default>
        </entry>
    </group>
</kcfg>
